<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_analysis_card"
    android:orientation="vertical"
    android:padding="8dp"
    android:elevation="14dp">

    <!-- Header bar: Title/Status, Start/Pause Button & Minimize -->
    <LinearLayout
        android:id="@+id/panelHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvEngineTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stockfish 19 • Siap"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Start / Pause Toggle -->
        <Button
            android:id="@+id/btnToggleEngine"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="▶️ START"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btnToggleMinimize"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="▼"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Content Area (Collapsible) -->
    <LinearLayout
        android:id="@+id/panelContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp">

        <!-- Mode Switch: Mode 1-Tap Auto-Lepas vs Mode Jeda Timer -->
        <Button
            android:id="@+id/btnToggleMode"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="🎯 MODE: 1-TAP (AUTO-LEPAS)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#059669"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:layout_marginBottom="3dp" />

        <!-- Top Candidates List (#1 to #5 + #H) -->
        <LinearLayout
            android:id="@+id/linesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#151E2E"
            android:padding="5dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLine1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="#1: Tekan START untuk bermain"
                android:textColor="#38BDF8"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLine2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLine3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLine4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLine5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLineHuman"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF6D00"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Pengaturan Jeda Waktu Gerak Bebas (Mode Jeda Timer) -->
        <LinearLayout
            android:id="@+id/delayContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="3dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏳ Jeda Gerak Bebas:"
                android:textColor="#94A3B8"
                android:textSize="9.5sp" />

            <Button
                android:id="@+id/btnDelayMinus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="26dp"
                android:layout_height="24dp"
                android:text="➖"
                android:textSize="7sp"
                android:padding="0dp" />

            <TextView
                android:id="@+id/tvDelayDuration"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="3 dtk"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDelayPlus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="26dp"
                android:layout_height="24dp"
                android:text="➕"
                android:textSize="7sp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Live Move History Display -->
        <HorizontalScrollView
            android:id="@+id/scrollMoveHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="#0F172A"
            android:paddingHorizontal="4dp"
            android:paddingVertical="3dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/tvMoveHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜 Riwayat: Belum ada langkah"
                android:textColor="#38BDF8"
                android:textSize="9.5sp"
                android:fontFamily="monospace"
                android:singleLine="true" />
        </HorizontalScrollView>

        <!-- MINI BOARD (SELALU AKTIF & TAMPIL DI LAYAR) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp">

            <com.chess.overlay.core.overlay.SetupBoardView
                android:id="@+id/setupBoardView"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center_horizontal" />
        </FrameLayout>

        <!-- Quick Game Action Bar (Gerak 1-Tap) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnApplyBestMove"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1.2"
                android:text="⚡ #1"
                android:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnUndoMove"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="0.75"
                android:text="↩️ Undo"
                android:textColor="#E2E8F0"
                android:textSize="8.5sp"
                android:padding="0dp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnRedoMove"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="0.75"
                android:text="↪️ Redo"
                android:textColor="#E2E8F0"
                android:textSize="8.5sp"
                android:padding="0dp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnFlipBoard"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="0.9"
                android:text="🔄 Hitam"
                android:textColor="#E2E8F0"
                android:textSize="8.5sp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Menu Bar 2: Reset & Buka Pengaturan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnResetBoard"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:text="♟️ Reset 32"
                android:textColor="#F59E0B"
                android:textSize="8.5sp"
                android:padding="0dp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnToggleSetup"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1.2"
                android:text="🛠️ Edit Bidak"
                android:textColor="#38BDF8"
                android:textSize="8.5sp"
                android:padding="0dp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnToggleCalibrate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="0.9"
                android:text="📐 Kalibrasi"
                android:textColor="#94A3B8"
                android:textSize="8.5sp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Sub-panel Setup Posisi (Buka saat klik Edit Bidak) -->
        <LinearLayout
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#151E2E"
            android:padding="4dp"
            android:layout_marginTop="3dp"
            android:visibility="gone">

            <!-- Bar Atas Setup: Kosongkan, Formasi 32, Giliran -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSetupClear"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:text="🗑️ Kosong"
                    android:textColor="#EF4444"
                    android:textSize="8sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnSetupDefault32"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:text="♟️ Standar"
                    android:textColor="#F59E0B"
                    android:textSize="8sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnSetupTurn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1.2"
                    android:text="Giliran: Hitam"
                    android:textColor="#E2E8F0"
                    android:textSize="8sp"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- Palette Bidak & Tool -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnToolMove"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="1.1"
                    android:text="🖐️ Geser"
                    android:backgroundTint="#0284C7"
                    android:textColor="#FFFFFF"
                    android:textSize="7.5sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnToolPawn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="0.8"
                    android:text="♙"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnToolKnight"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="0.8"
                    android:text="♘"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnToolBishop"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="0.8"
                    android:text="♗"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnToolRook"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="0.8"
                    android:text="♖"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnToolQueen"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="0.8"
                    android:text="♕"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnToolKing"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="0.8"
                    android:text="♔"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnToolDelete"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="0.8"
                    android:text="❌"
                    android:textColor="#EF4444"
                    android:textSize="8sp"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- Toggle Warna Bidak yang Ditaruh -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPieceColorToggle"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="1"
                    android:text="Warna Bidak: ⚪ Putih"
                    android:textColor="#E2E8F0"
                    android:textSize="8sp"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- Selesai & Hitung Posisi Ini -->
            <Button
                android:id="@+id/btnFinishSetup"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:text="🚀 Simpan &amp; Hitung Posisi"
                android:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Calibration Sub-panel (Titik Tracker & Penyelarasan Papan & Sensor Teks) -->
        <LinearLayout
            android:id="@+id/calibrationPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="3dp"
            android:background="#1E293B"
            android:padding="4dp"
            android:visibility="gone">

            <!-- Baris 1: Papan Catur -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📐 Papan:"
                    android:textColor="#38BDF8"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnMoveUp"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:text="⬆️"
                    android:textSize="8sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnMoveDown"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:text="⬇️"
                    android:textSize="8sp"
                    android:padding="0dp"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnScalePlus"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:text="➕"
                    android:textSize="8sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnScaleMinus"
                    android:layout_width="28dp"
                    android:layout_height="26dp"
                    android:text="➖"
                    android:textSize="8sp"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
