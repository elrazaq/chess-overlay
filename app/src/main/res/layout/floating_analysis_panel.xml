<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_analysis_card"
    android:orientation="vertical"
    android:padding="10dp"
    android:elevation="14dp">

    <!-- Header bar: Engine Info, Start/Pause & Minimize -->
    <LinearLayout
        android:id="@+id/panelHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvEngineTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stockfish 19 • Siap"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggleEngine"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="▶️ START"
            android:textSize="10sp"
            android:textStyle="bold"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="8dp" />

        <TextView
            android:id="@+id/btnToggleMinimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="▼"
            android:textColor="#CBD5E1"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Content Area (Collapsible) -->
    <LinearLayout
        android:id="@+id/panelContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp">

        <!-- Top Candidates List (5 Lines) -->
        <LinearLayout
            android:id="@+id/linesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#151E2E"
            android:padding="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLine1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tekan START untuk memulai kalkulasi."
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLine2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLine3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLine4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLine5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Quick Game Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnApplyBestMove"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1.3"
                android:text="✅ Terapkan #1"
                android:backgroundTint="#0EA5E9"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnInputManual"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1.3"
                android:text="🖐️ Tap Layar"
                android:textColor="#E2E8F0"
                android:textSize="9.5sp"
                android:padding="0dp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnUndoMove"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="0.8"
                android:text="↩️ Undo"
                android:textColor="#E2E8F0"
                android:textSize="9.5sp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Setup & Kalibrasi Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnResetBoard"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1.3"
                android:text="♟️ Reset 32 Bidak"
                android:textColor="#F59E0B"
                android:textSize="9sp"
                android:padding="0dp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnFlipBoard"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="🔄 Hitam"
                android:textColor="#E2E8F0"
                android:textSize="9sp"
                android:padding="0dp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnToggleCalibrate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="📐 Kalibrasi"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Button Toggle Buka/Tutup Setup Posisi -->
        <Button
            android:id="@+id/btnToggleSetup"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:text="🛠️ Setup Posisi Papan (Mid/Endgame)"
            android:textColor="#38BDF8"
            android:textSize="9.5sp"
            android:padding="0dp" />

        <!-- Sub-panel Setup Posisi (Default: GONE) -->
        <LinearLayout
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#151E2E"
            android:padding="6dp"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <!-- Bar Atas Setup: Kosongkan, Formasi 32, Giliran -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSetupClear"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:text="🗑️ Kosong"
                    android:textColor="#EF4444"
                    android:textSize="8.5sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnSetupDefault32"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:text="♟️ 32 Bidak"
                    android:textColor="#F59E0B"
                    android:textSize="8.5sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnSetupTurn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1.2"
                    android:text="Giliran: Hitam"
                    android:textColor="#E2E8F0"
                    android:textSize="8.5sp"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- Papan Catur Mini Setup -->
            <com.chess.overlay.core.overlay.SetupBoardView
                android:id="@+id/setupBoardView"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp" />

            <!-- Palette Bidak & Tool -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnToolMove"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1.2"
                    android:text="🖐️ Pindah"
                    android:backgroundTint="#0284C7"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnToolPawn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="0.8"
                    android:text="♙"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnToolKnight"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="0.8"
                    android:text="♘"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnToolBishop"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="0.8"
                    android:text="♗"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnToolRook"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="0.8"
                    android:text="♖"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnToolQueen"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="0.8"
                    android:text="♕"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnToolKing"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="0.8"
                    android:text="♔"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:padding="0dp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnToolDelete"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="0.8"
                    android:text="❌"
                    android:textColor="#EF4444"
                    android:textSize="9sp"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- Toggle Warna Bidak yang Ditaruh -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPieceColorToggle"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:text="Warna Bidak: ⚪ Putih"
                    android:textColor="#E2E8F0"
                    android:textSize="8.5sp"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- Selesai & Hitung Posisi Ini -->
            <Button
                android:id="@+id/btnFinishSetup"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:text="🚀 Selesai &amp; Hitung Posisi Ini"
                android:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Calibration Sub-panel -->
        <LinearLayout
            android:id="@+id/calibrationPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:background="#1E293B"
            android:padding="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atur Papan: "
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnMoveUp"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:text="⬆️"
                android:textSize="10sp"
                android:padding="0dp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnMoveDown"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:text="⬇️"
                android:textSize="10sp"
                android:padding="0dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnScalePlus"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:text="➕"
                android:textSize="10sp"
                android:padding="0dp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnScaleMinus"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:text="➖"
                android:textSize="10sp"
                android:padding="0dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
